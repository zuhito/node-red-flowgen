{
  "name": "node-red-flowgen",
  "version": "0.25.0",
  "description": "Generate Node-RED flows and function-node code from OpenAPI 3 / Swagger 2 documents",
  "main": "flowgen.js",
  "license": "Apache-2.0",
  "bin": {
    "node-red-flowgen": "flowgen.js"
  },
  "files": [
    "flowgen.js",
    "flowgen-plugin.js",
    "flowgen-plugin.html",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.5.0"
  },
  "dependencies": {
    "js-yaml": "5.2.3",
    "yauzl": "3.4.0"
  },
  "node-red": {
    "version": ">=4.0.3",
    "plugins": {
      "flowgen": "flowgen-plugin.js"
    }
  },
  "keywords": [
    "node-red",
    "openapi",
    "swagger"
  ],
  "scripts": {
    "test": "node --test tests/test.js tests/test-cli.js tests/test-bruno.js",
    "test:ui": "node --test tests/test-ui.js",
    "test:nodered": "node --test tests/test-nodered.js",
    "test:plugin": "node --test tests/test-plugin.js",
    "test:all": "node --test tests/test.js tests/test-cli.js tests/test-bruno.js tests/test-ui.js tests/test-nodered.js tests/test-plugin.js",
    "test:browser": "node --test --test-timeout 600000 tests/test-browser.js",
    "test:live": "node tests/test-live.js",
    "coverage": "npx c8 --reporter=text --reporter=text-summary --reporter=lcov --reporter=html --include=flowgen.js --include=flowgen-plugin.js --report-dir=coverage node --test --test-timeout 300000 tests/test.js tests/test-cli.js tests/test-bruno.js tests/test-nodered.js tests/test-plugin.js tests/test-plugin-unit.js tests/test-wizard.js tests/test-converters.js tests/test-error-words.js tests/test-nrlint.js",
    "test:ollama": "node --test --test-timeout 900000 tests/test-ollama.js",
    "test:plugin:unit": "node --test tests/test-plugin-unit.js",
    "samples": "node tests/generate-samples.js",
    "lint": "eslint -c tests/eslint.config.js . && node tests/lint-html.js",
    "lint:js": "eslint -c tests/eslint.config.js .",
    "lint:html": "node tests/lint-html.js",
    "check:node-floor": "node tests/check-node-floor.js",
    "search:node-floor": "node tests/find-node-floor.js",
    "test:digest": "RUN_DIGEST_TESTS=1 node --test tests/test-digest.js",
    "test:errorwords": "node --test tests/test-error-words.js",
    "check:bruno-guide": "node tests/check-bruno-guide.js",
    "test:corpus": "node tests/test-corpus.js",
    "build:corpus": "node tests/build-corpus.js",
    "test:formats": "node --test tests/test-formats.js",
    "generate:formats": "node tests/generate-formats.js",
    "test:converters": "node --test tests/test-converters.js",
    "test:nrlint": "node --test tests/test-nrlint.js",
    "test:wizard": "node --test --test-timeout 300000 tests/test-wizard.js",
    "check:httpbingo": "node tests/check-httpbingo.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@usebruno/converters": "^0.22.0",
    "c8": "10.1.3",
    "eslint": "^9.39.5",
    "express": "5.2.1",
    "jquery": "4.0.0",
    "jsdom": "30.0.1",
    "node-red": "5.0.4",
    "nrlint": "^1.2.0",
    "playwright": "1.56.1",
    "postman-to-openapi": "^1.7.3",
    "swagger2openapi": "^7.0.8",
    "v8-to-istanbul": "9.3.0"
  }
}