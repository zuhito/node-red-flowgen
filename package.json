{
  "name": "node-red-flowgen",
  "version": "1.3.0",
  "description": "Generate Node-RED flows and function-node code from OpenAPI 3 / Swagger 2 documents",
  "main": "flowgen.js",
  "scripts": {
    "test": "node --test test.js",
    "test:nodered": "node --test test-nodered.js",
    "test:all": "node --test test.js test-ui.js test-nodered.js test-plugin.js",
    "test:plugin": "node --test test-plugin.js",
    "test:live": "node test-live.js",
    "test:ui": "node --test test-ui.js"
  },
  "license": "MIT",
  "bin": {
    "flowgen": "flowgen.js"
  },
  "files": [
    "flowgen.js",
    "plugin/",
    "spec/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "4.3.0"
  },
  "devDependencies": {
    "express": "^4.19.2",
    "jquery": "^3.7.1",
    "jsdom": "^24.0.0",
    "node-red": "^4.0.0"
  },
  "node-red": {
    "version": ">=3.0.0",
    "plugins": {
      "flowgen": "plugin/flowgen-plugin.js"
    }
  },
  "keywords": [
    "node-red",
    "openapi",
    "swagger"
  ]
}