{
  "name": "node-red-flowgen",
  "version": "1.10.2",
  "description": "Generate Node-RED flows and function-node code from OpenAPI 3 / Swagger 2 documents",
  "main": "flowgen.js",
  "license": "Apache-2.0",
  "bin": {
    "node-red-flowgen": "flowgen.js"
  },
  "files": [
    "flowgen.js",
    "flowgen-plugin.js",
    "flowgen-plugin.html",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "js-yaml": "5.2.3"
  },
  "node-red": {
    "version": ">=3.0.0",
    "plugins": {
      "flowgen": "flowgen-plugin.js"
    }
  },
  "keywords": [
    "node-red",
    "openapi",
    "swagger"
  ],
  "scripts": {}
}