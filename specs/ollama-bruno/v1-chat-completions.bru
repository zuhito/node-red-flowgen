meta {
  name: v1-chat-completions
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
}

headers {
  accept: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "stream": false,
    "temperature": 0.8,
    "max_tokens": 1000,
    "seed": 0
  }
}
